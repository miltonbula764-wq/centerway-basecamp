[Unit]
Description=CENTERWAY Caddy HTTPS gateway (activation requires domain and DNS)
After=network-online.target centerway-api.service
Wants=network-online.target centerway-api.service

[Service]
User=caddy
Group=caddy
WorkingDirectory=/opt/centerway-basecamp/recovery-mvp/infra
EnvironmentFile=/etc/centerway/gateway.env
Environment=XDG_DATA_HOME=/var/lib/caddy/data XDG_CONFIG_HOME=/var/lib/caddy/config
ExecStartPre=/opt/centerway-venv/bin/python /opt/centerway-basecamp/recovery-mvp/infra/preflight.py gateway
ExecStartPre=/usr/local/bin/centerway-caddy validate --config /opt/centerway-basecamp/recovery-mvp/infra/Caddyfile --adapter caddyfile
ExecStart=/usr/local/bin/centerway-caddy run --config /opt/centerway-basecamp/recovery-mvp/infra/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=5
UMask=0077
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/caddy
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
