              },
              "arguments": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "detection_id",
                  "contract_revision",
                  "question"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "detection_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "contract_revision": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "question": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "request_id",
              "operation",
              "arguments"
            ],
            "properties": {
              "request_id": {
                "type": "string",
                "format": "uuid"
              },
              "operation": {
                "const": "append_investigation"
              },
              "arguments": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "investigation_id",
                  "kind",
                  "id",
                  "expected_revision",
                  "reason",
                  "data"
                ],
                "properties": {
                  "investigation_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "kind": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  },
                  "id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "expected_revision": {
                    "type": "integer",
