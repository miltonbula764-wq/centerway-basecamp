    "/v1/tenants/{tenant}/clients": {
      "get": {
        "summary": "List server-provisioned HTTP client scopes intersected with current PostgreSQL tenant membership",
        "description": "Only persisted names. Keyset order by client UUID. No tenant-wide discovery permission grants read access. Unknown/repeated query parameters rejected. Does not return totals or cross-tenant existence.",
        "security": [
          {
            "SessionBearer": []
          }
        ],
        "parameters": [
          {
            "name": "tenant",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            },
            "description": "Canonical positive decimal digits only, no leading zeros."
          },
          {
            "name": "after",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Exclusive UUID cursor from next_cursor; never an authorization grant."
          }
        ],
        "responses": {
          "200": {
            "description": "Authorized page; empty authorized scope returns data=[] and next_cursor=null.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientDirectoryPage"
                },
                "example": {
                  "data": [],
                  "next_cursor": null,
                  "demo": false
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Failure"
          },
          "401": {
            "$ref": "#/components/responses/Failure"
          },
          "403": {
            "$ref": "#/components/responses/Failure"
          },
          "422": {
            "$ref": "#/components/responses/Failure"
          },
          "500": {
