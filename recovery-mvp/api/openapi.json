{
  "openapi": "3.1.0",
  "info": {
    "title": "CENTERWAY independent MVP L01",
    "version": "l01-v1",
    "description": "Local HTTP transport. Detailed semantics and limitations in README.md."
  },
  "components": {
    "securitySchemes": {
      "SessionBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Opaque server session"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code"
            ],
            "properties": {
              "code": {
                "type": "string"
              }
            }
          }
        }
      },
      "SessionToken": {
        "type": "object",
        "required": [
          "access_token",
          "token_type",
          "expires_in",
          "demo"
        ],
        "properties": {
          "access_token": {
            "type": "string"
          },
          "token_type": {
            "const": "Bearer"
          },
          "expires_in": {
            "type": "integer"
          },
          "demo": {
            "type": "boolean"
          }
        }
      },
      "SessionInfo": {
        "type": "object",
        "required": [
          "username",
          "principal",
          "operations",
          "clients",
          "company_tenants"
        ],
        "properties": {
          "username": {
            "type": "string"
          },
          "principal": {
            "type": "string"
          },
          "operations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "clients": {
            "type": "object"
          },
          "company_tenants": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      },
      "Envelope": {
        "type": "object",
        "required": [
          "data",
          "demo"
        ],
        "properties": {
          "data": {
            "type": "object",
            "description": "Immutable F06 receipt or client journey; see ORCHESTRATION.md"
          },
          "demo": {
            "type": "boolean"
          }
        }
      },
      "Operation": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "request_id",
              "operation",
              "arguments"
            ],
            "properties": {
              "request_id": {
                "type": "string",
                "format": "uuid"
              },
              "operation": {
                "const": "append_value"
              },
              "arguments": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "id",
                  "expected_revision",
                  "reason",
                  "data"
                ],
                "properties": {
                  "kind": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  },
                  "id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "expected_revision": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  },
                  "data": {
                    "type": "object"
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "request_id",
              "operation",
              "arguments"
            ],
            "properties": {
              "request_id": {
                "type": "string",
                "format": "uuid"
              },
              "operation": {
                "const": "detect"
              },
              "arguments": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "contract_id",
                  "revisions",
                  "as_of",
                  "required_periods"
                ],
                "properties": {
                  "contract_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "revisions": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 120,
                    "items": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "as_of": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "required_periods": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "request_id",
              "operation",
              "arguments"
            ],
            "properties": {
              "request_id": {
                "type": "string",
                "format": "uuid"
              },
              "operation": {
                "const": "discover_company"
              },
