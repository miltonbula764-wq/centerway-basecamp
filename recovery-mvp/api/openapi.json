                  "post_revision": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "request_id",
              "operation",
              "arguments"
            ],
            "properties": {
              "request_id": {
                "type": "string",
