            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "request_id",
              "operation",
              "arguments"
            ],
            "properties": {
              "request_id": {
                "type": "string",
                "format": "uuid"
              },
              "operation": {
                "const": "plan_recovery"
