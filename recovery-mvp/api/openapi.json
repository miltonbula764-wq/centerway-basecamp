{
  "openapi": "3.1.0",
  "info": {
    "title": "CENTERWAY independent MVP L01",
    "version": "c02-v1",
    "description": "Authenticated HTTP transport with authorized client directory. HTTPS preparation in ../infra/README.md; no published service."
  },
  "components": {
    "securitySchemes": {
      "SessionBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Opaque server session"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code"
            ],
            "properties": {
              "code": {
                "type": "string"
              }
            }
          }
        }
      },
      "SessionToken": {
        "type": "object",
        "required": [
          "access_token",
          "token_type",
          "expires_in",
          "demo"
        ],
        "properties": {
          "access_token": {
            "type": "string"
          },
          "token_type": {
            "const": "Bearer"
          },
          "expires_in": {
            "type": "integer"
          },
          "demo": {
            "type": "boolean"
          }
        }
      },
      "SessionInfo": {
        "type": "object",
        "required": [
          "username",
          "principal",
          "operations",
          "clients",
          "company_tenants"
        ],
        "properties": {
          "username": {
            "type": "string"
          },
          "principal": {
            "type": "string"
          },
          "operations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "clients": {
            "type": "object"
          },
          "company_tenants": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      },
      "Envelope": {
        "type": "object",
        "required": [
          "data",
          "demo"
        ],
        "properties": {
          "data": {
            "type": "object",
            "description": "Immutable F06 receipt or client journey; see ORCHESTRATION.md"
          },
          "demo": {
            "type": "boolean"
          }
        }
      },
      "Operation": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "request_id",
              "operation",
              "arguments"
            ],
            "properties": {
              "request_id": {
                "type": "string",
                "format": "uuid"
              },
              "operation": {
                "const": "append_value"
              },
              "arguments": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "id",
                  "expected_revision",
                  "reason",
                  "data"
                ],
                "properties": {
                  "kind": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  },
                  "id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "expected_revision": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  },
                  "data": {
                    "type": "object"
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "request_id",
              "operation",
              "arguments"
            ],
            "properties": {
              "request_id": {
                "type": "string",
                "format": "uuid"
              },
              "operation": {
                "const": "detect"
              },
              "arguments": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "contract_id",
                  "revisions",
                  "as_of",
                  "required_periods"
                ],
                "properties": {
                  "contract_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "revisions": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 120,
                    "items": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "as_of": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "required_periods": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "request_id",
              "operation",
              "arguments"
            ],
            "properties": {
              "request_id": {
                "type": "string",
                "format": "uuid"
              },
              "operation": {
                "const": "discover_company"
              },
              "arguments": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "as_of"
                ],
                "properties": {
                  "as_of": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "request_id",
              "operation",
              "arguments"
            ],
            "properties": {
              "request_id": {
                "type": "string",
                "format": "uuid"
              },
              "operation": {
                "const": "open_investigation"
              },
              "arguments": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "detection_id",
                  "contract_revision",
                  "question"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "detection_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "contract_revision": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "question": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "request_id",
              "operation",
              "arguments"
            ],
            "properties": {
              "request_id": {
                "type": "string",
                "format": "uuid"
              },
              "operation": {
                "const": "append_investigation"
              },
              "arguments": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "investigation_id",
                  "kind",
                  "id",
                  "expected_revision",
                  "reason",
                  "data"
                ],
                "properties": {
                  "investigation_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "kind": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  },
                  "id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "expected_revision": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  },
                  "data": {
                    "type": "object"
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "request_id",
              "operation",
              "arguments"
            ],
            "properties": {
              "request_id": {
                "type": "string",
                "format": "uuid"
              },
              "operation": {
                "const": "investigate"
              },
              "arguments": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "investigation_id",
                  "as_of"
                ],
                "properties": {
                  "investigation_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "as_of": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "request_id",
              "operation",
              "arguments"
            ],
            "properties": {
              "request_id": {
                "type": "string",
                "format": "uuid"
              },
              "operation": {
                "const": "intervene"
              },
              "arguments": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "investigation_id",
                  "report_id"
                ],
                "properties": {
                  "investigation_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "report_id": {
                    "type": "string",
                    "format": "uuid"
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "request_id",
              "operation",
              "arguments"
            ],
            "properties": {
              "request_id": {
                "type": "string",
                "format": "uuid"
              },
              "operation": {
                "const": "undo"
              },
              "arguments": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "execution_id"
                ],
                "properties": {
                  "execution_id": {
                    "type": "string",
                    "format": "uuid"
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "request_id",
              "operation",
              "arguments"
            ],
            "properties": {
              "request_id": {
                "type": "string",
                "format": "uuid"
              },
              "operation": {
                "const": "plan_recovery"
              },
              "arguments": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "decision_id",
                  "pre_revision",
                  "post_revision",
                  "reason"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "decision_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "pre_revision": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "post_revision": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "request_id",
              "operation",
              "arguments"
            ],
            "properties": {
              "request_id": {
                "type": "string",
                "format": "uuid"
              },
              "operation": {
                "const": "evaluate_recovery"
              },
              "arguments": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "plan_id",
                  "as_of"
                ],
                "properties": {
                  "plan_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "as_of": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              }
            }
          }
        ]
      },
      "Login": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "username": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "writeOnly": true
          }
        }
      },
      "ClientDirectoryPage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "data",
          "next_cursor",
          "demo"
        ],
        "properties": {
          "data": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "client_id",
                "display_name"
              ],
              "properties": {
                "client_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "display_name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                }
              }
            }
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "Last returned client_id when more authorized rows exist; null at end."
          },
          "demo": {
            "type": "boolean"
          }
        }
      }
    },
    "responses": {
      "Failure": {
        "description": "Sanitized error or persisted F06 rejection; see README.md",
        "content": {
          "application/json": {
            "schema": {
              "oneOf": [
                {
                  "$ref": "#/components/schemas/Error"
                },
                {
                  "$ref": "#/components/schemas/Envelope"
                }
              ]
            }
          }
        }
      }
    }
  },
