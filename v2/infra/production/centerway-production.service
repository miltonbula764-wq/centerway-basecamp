# Template only: no installation, activation or deployment is authorized here.
[Unit]
Description=CENTERWAY permanent private foundation (business operations disabled)
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=3
RequiresMountsFor=/var/lib/centerway-production

[Service]
Type=simple
User=centerway-production
Group=centerway-production
WorkingDirectory=/opt/centerway/v2
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=TZ=UTC
EnvironmentFile=/etc/centerway/production/runtime.env
UMask=0077
StateDirectory=centerway-production
StateDirectoryMode=0700
ExecStartPre=/usr/bin/python3 -m centerway.ops check --mode production --db /var/lib/centerway-production/production.sqlite3 --origin ${CENTERWAY_ORIGIN}
ExecStart=/usr/bin/python3 -m centerway.runtime serve --mode production --db /var/lib/centerway-production/production.sqlite3 --certfile /etc/centerway/production/backend-cert.pem --keyfile /etc/centerway/production/backend-key.pem --host 127.0.0.1 --port 9443
Restart=on-failure
RestartSec=10
TimeoutStopSec=45
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/centerway-production

[Install]
WantedBy=multi-user.target
