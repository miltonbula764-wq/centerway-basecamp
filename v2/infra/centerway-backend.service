# Template: do not install/enable without a separate deployment authorization.
[Unit]
Description=CENTERWAY V2 private sandbox backend
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=3
RequiresMountsFor=/var/lib/centerway

[Service]
Type=simple
User=centerway
Group=centerway
WorkingDirectory=/opt/centerway/v2
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=TZ=UTC
EnvironmentFile=/etc/centerway/runtime.env
UMask=0077
StateDirectory=centerway
StateDirectoryMode=0700
ExecStartPre=/usr/bin/python3 -m centerway.ops check --db /var/lib/centerway/preview.sqlite3 --origin ${CENTERWAY_ORIGIN}
ExecStart=/usr/bin/python3 -m centerway.preview serve --db /var/lib/centerway/preview.sqlite3 --certfile /etc/centerway/backend-cert.pem --keyfile /etc/centerway/backend-key.pem --host 127.0.0.1 --port 8443
Restart=on-failure
RestartSec=10
TimeoutStopSec=45
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/centerway

[Install]
WantedBy=multi-user.target
